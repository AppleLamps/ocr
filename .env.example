# Z.AI API key for GLM-OCR (required). Get one at https://z.ai/model-api
ZAI_API_KEY=your-api-key-here

# Vercel Blob store (required). The browser uploads files here and Z.AI fetches
# them by URL, bypassing the serverless function payload limit.
# Provisioned under the `zaiblob_` prefix for this project.
zaiblob_READ_WRITE_TOKEN=your-blob-read-write-token
zaiblob_STORE_ID=your-blob-store-id

# Blob store access: `private` (Vercel default) or `public`. Must match your store.
# Client uploads and OCR both read this via next.config.js.
BLOB_ACCESS=private

# Optional: per-IP rate limit for /api/ocr (defaults shown).
OCR_RATE_LIMIT_MAX=10
OCR_RATE_LIMIT_WINDOW_MS=60000
